# =============================================================================
# EquiBudget - Umgebungskonfiguration / Environment Configuration Template
# =============================================================================
# Kopiere diese Datei nach .env vor dem Start:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PostgreSQL 16 Datenbank
# -----------------------------------------------------------------------------
POSTGRES_DB="equibudget"
POSTGRES_USER="equibudget"
POSTGRES_PASSWORD="change_me_super_secret_db_pass"

# -----------------------------------------------------------------------------
# 2. Authentifizierungs-Modus (Forward-Auth oder Standalone JWT)
# -----------------------------------------------------------------------------
# Optionen:
#   'reverse_proxy'  -> Nutzt HTTP-Header von Pangolin, Newt, Authelia, Traefik
#   'standalone_jwt' -> Nutzt lokales Login mit JSON Web Tokens
AUTH_MODE="reverse_proxy"
FORWARDED_USER_HEADER="X-Forwarded-User"
FORWARDED_EMAIL_HEADER="X-Auth-Request-Email"
FORWARDED_GROUPS_HEADER="X-Forwarded-Groups"

# Geheimes Token für Standalone-Login (mindestens 32 Zufallszeichen für Produktion)
JWT_SECRET_KEY="insecure_dev_jwt_secret_change_in_prod"

# -----------------------------------------------------------------------------
# 3. Frontend & Netzwerk-Ports
# -----------------------------------------------------------------------------
# Exponierter Port auf dem Docker-Host für den Webzugriff
FRONTEND_PORT="3000"

# Relativer oder absoluter Pfad zum Backend REST-API
VITE_API_URL="/api"

# -----------------------------------------------------------------------------
# 4. KI-gestütztes Transaktions-Matching & Ingestion
# -----------------------------------------------------------------------------
# Optionen: 'gemini', 'ollama', oder 'heuristic' (Offline-Mustererkennung)
AI_CLASSIFIER_PROVIDER="gemini"

# GEMINI_API_KEY: Optionaler API-Key für Google Gemini zur KI-Kategorisierung
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Basis-URL der Applikation (z. B. https://budget.mein-homelab.de)
APP_URL="http://localhost:3000"
