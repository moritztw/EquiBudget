# =============================================================================
# EquiBudget — Self-Hosting Konfiguration (.env Vorlage)
# Kopieren nach .env:  cp .env.example .env
# Geheimnisse erzeugen: openssl rand -hex 32
# =============================================================================

# Zeitzone & lokaler Gateway-Port (für Reverse Proxy oder Pangolin / Newt)
TZ="Europe/Berlin"
EQUIBUDGET_BIND_ADDRESS="127.0.0.1"
EQUIBUDGET_HTTP_PORT="8080"

# --- PostgreSQL 16 Datenbank ---
POSTGRES_DB="equibudget"
POSTGRES_USER="equibudget"
POSTGRES_PASSWORD="CHANGE_ME_WITH_STRONG_PASSWORD"

# --- FastAPI Backend (Python 3.12 / SQLAlchemy 2.0 asyncpg) ---
EQUIBUDGET_ENVIRONMENT="production"
EQUIBUDGET_WEB_CONCURRENCY="2"
EQUIBUDGET_DATABASE_URL="postgresql+asyncpg://equibudget:CHANGE_ME_WITH_STRONG_PASSWORD@postgres:5432/equibudget"

# --- Reverse-Proxy Forward-Auth (Pangolin / Newt / Authelia / Authentik) ---
EQUIBUDGET_FORWARD_AUTH_ENABLED="true"
EQUIBUDGET_FORWARD_AUTH_USER_HEADER="X-Forwarded-User"
EQUIBUDGET_FORWARD_AUTH_EMAIL_HEADER="X-Forwarded-Email"

# --- Lokaler JWT-Fallback (mindestens 32 Zeichen; z.B. `openssl rand -hex 32`) ---
EQUIBUDGET_JWT_SECRET_KEY="replace_this_with_a_64_char_random_hex_secret_before_first_start"
EQUIBUDGET_JWT_ALGORITHM="HS256"
EQUIBUDGET_JWT_ACCESS_TOKEN_EXPIRE_MINUTES="480"

# --- Optional: Eingebauter Pangolin / Newt Tunnel (`docker compose --profile pangolin up -d`) ---
PANGOLIN_ENDPOINT=""
NEWT_ID=""
NEWT_SECRET=""
